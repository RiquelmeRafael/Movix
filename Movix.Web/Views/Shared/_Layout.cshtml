@* refatorado fase 5 *@

<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">
<head>
	<meta charset="utf-8" />
	<title>@ViewData["Title"]  - Movix </title>
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<link rel="stylesheet"
		  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/style.css" />
	<link rel="shortcut icon" href="/img/Icone.png" type="image/x-icon">

	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

	<!-- No head do _Layout.cshtml -->
	<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
	<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
	<link rel="shortcut icon" href="./img/Icone.png" type="image/x-icon">







	<!-- Antes de fechar o body no _Layout.cshtml -->
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
	<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
	<script>
		// Inicializar AOS para animações
		document.addEventListener('DOMContentLoaded', function() {
			if (typeof AOS !== 'undefined') {
				AOS.init({
					duration: 1000,
					once: true,
					offset: 100
				});
			}

			// Animação de scroll suave
			document.querySelectorAll('a[href^="#"]').forEach(anchor => {
				anchor.addEventListener('click', function (e) {
					e.preventDefault();
					const target = document.querySelector(this.getAttribute('href'));
					if (target) {
						target.scrollIntoView({
							behavior: 'smooth'
						});
					}
				});
			});
		});
	</script>

</head>
<body>


	<header>





		<nav class="navbar navbar-expand-lg navbar-dark fixed-top py-2" data-aos="fade-down" data-aos-duration="1500" style="background: linear-gradient(to bottom, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0) 100%);">
			<div class="container">
				<a class="navbar-brand" asp-controller="Home" asp-action="Index">
					<img src='~/img/Logo.png' alt="Movix" style="height: 80px; width: auto;">
				</a>
				
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMovix" aria-controls="navbarMovix" aria-expanded="false" aria-label="Toggle navigation" style="background-color: rgba(0,0,0,0.5);">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="collapse navbar-collapse" id="navbarMovix" style="z-index: 9999;">
					
					<!-- Container estilizado estilo cápsula apenas para desktop -->
					<div class="d-none d-lg-flex mx-auto align-items-center justify-content-center px-4 py-2" 
						 style="background-color: #000; border: 3px solid #333; border-radius: 50px; box-shadow: 0 4px 15px rgba(0,0,0,0.8);">
						<ul class="navbar-nav d-flex gap-4 m-0">
							<li class="nav-item">
								<a class="nav-link text-secondary fw-bold" asp-controller="Home" asp-action="Index" style="font-size: 16px;">Início</a>
							</li>
							<li class="nav-item">
								<a class="nav-link text-secondary fw-bold" asp-controller="Home" asp-action="Planos" style="font-size: 16px;">Planos</a>
							</li>
							<li class="nav-item">
								<a class="nav-link text-secondary fw-bold" asp-controller="Home" asp-action="Filmes" style="font-size: 16px;">Filmes</a>
							</li>

							@if (User.Identity?.IsAuthenticated ?? false)
							{
								bool isAdmin = User.IsInRole("ADMIN") || User.IsInRole("Admin") || User.IsInRole("Administrador");
								if (isAdmin)
								{
									<li class="nav-item"><a class="nav-link text-secondary fw-bold" href="/Admin/Dashboard" style="font-size: 16px;">Gestão</a></li>
								}
							}
						</ul>
					</div>

					<!-- Lista padrão para mobile (d-lg-none) -->
					<ul class="navbar-nav d-lg-none ms-auto align-items-center gap-3 mt-3 p-3 rounded" style="background-color: rgba(0,0,0,0.95);">
						<li class="nav-item">
							<a class="nav-link text-white fs-5" asp-controller="Home" asp-action="Index">Início</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-white fs-5" asp-controller="Home" asp-action="Planos">Planos</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-white fs-5" asp-controller="Home" asp-action="Filmes">Filmes</a>
						</li>
						@if (User.Identity?.IsAuthenticated ?? false)
						{
							bool isAdmin = User.IsInRole("ADMIN") || User.IsInRole("Admin") || User.IsInRole("Administrador");
							if (isAdmin)
							{
								<li class="nav-item"><a class="nav-link text-white fs-5" href="/Admin/Dashboard">Gestão</a></li>
							}
						}
					</ul>

					<div class="d-flex ms-lg-auto mt-3 mt-lg-0 align-items-center justify-content-center gap-3">
						@if (User.Identity?.IsAuthenticated ?? false)
						{
							<a href="#" class="btn btn-danger rounded-pill px-4" onclick="document.getElementById('logout-form').submit();">
								Sair (@User.Identity?.Name)
							</a>
							<form id="logout-form" asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="d-none">
								@Html.AntiForgeryToken()
							</form>
						}
						else
						{
							<a class="btn btn-primary rounded-pill px-4 fw-bold" href="/Auth/Login" style="background: linear-gradient(90deg, #00E5FF, #2979FF, #AA00FF); border: none;">
								Perfil
							</a>
						}
					</div>
				</div>
			</div>
		</nav>


	</header>

	<main class="py-4">
		<div class="container">
			@RenderBody()
		</div>

	</main>




	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script>
		// Fecha o menu mobile ao clicar em um link
		document.addEventListener('DOMContentLoaded', function () {
			const navLinks = document.querySelectorAll('.navbar-collapse .nav-link:not(.dropdown-toggle)');
			const menuToggle = document.getElementById('navbarMovix');
			if (menuToggle) {
				const bsCollapse = new bootstrap.Collapse(menuToggle, { toggle: false });
				navLinks.forEach(function (l) {
					l.addEventListener('click', function () {
						if (menuToggle.classList.contains('show')) {
							bsCollapse.hide();
						}
					});
				});
			}
		});
	</script>
	@RenderSection("Scripts", required: false)
</body>
</html>

